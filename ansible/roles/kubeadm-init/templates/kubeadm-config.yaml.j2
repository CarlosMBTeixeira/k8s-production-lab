# ============================================================================
# /etc/kubernetes/kubeadm-config.yaml
# Generated by Ansible role kubeadm-init.
# DO NOT EDIT MANUALLY — changes are overwritten on next playbook run.
# ============================================================================

# --- InitConfiguration -------------------------------------------------------
# Node-specific bootstrap parameters: which CRI socket to use, what name
# this node should register as in the cluster.
apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
nodeRegistration:
  criSocket: "{{ kubeadm_init_cri_socket }}"
  name: "{{ ansible_facts['hostname'] }}"
  kubeletExtraArgs:
    - name: node-ip
      # Use ansible_host (the IP Ansible connects through) instead of
      # ansible_default_ipv4.address. Multipass/QEMU can issue multiple
      # DHCP leases during a single VM boot, and ansible_default_ipv4 may
      # capture a transient IP that no longer exists by the time kubelet
      # starts. ansible_host comes from the inventory (resolved via
      # ~/.ssh/config, which sync-ssh-config.sh keeps current) and is
      # stable for the entire play duration. See ADR-020.
      value: "{{ ansible_host }}"

---
# --- ClusterConfiguration ----------------------------------------------------
# Cluster-wide settings: K8s version, networking ranges, etcd location.
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
kubernetesVersion: "{{ kubeadm_init_kubernetes_version }}"
networking:
  podSubnet: "{{ kubeadm_init_pod_subnet }}"
  serviceSubnet: "{{ kubeadm_init_service_subnet }}"
  dnsDomain: "{{ kubeadm_init_cluster_dns_domain }}"

---
# --- KubeletConfiguration ----------------------------------------------------
# Kubelet-specific settings on this node. cgroupDriver MUST match
# containerd's SystemdCgroup setting (see ADR-013).
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
cgroupDriver: "{{ kubeadm_init_cgroup_driver }}"
