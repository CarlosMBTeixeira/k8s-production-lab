# ============================================================================
# /etc/kubernetes/kubeadm-config.yaml
# Generated by Ansible role kubeadm-init.
# DO NOT EDIT MANUALLY — changes are overwritten on next playbook run.
# ============================================================================

# --- InitConfiguration -------------------------------------------------------
apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
nodeRegistration:
  criSocket: "{{ kubeadm_init_cri_socket }}"
  name: "{{ ansible_facts['hostname'] }}"
  kubeletExtraArgs:
    - name: node-ip
      # See ADR-020: ansible_host (inventory-resolved) instead of
      # ansible_default_ipv4.address, which can capture a transient DHCP lease.
      value: "{{ ansible_host }}"

---
# --- ClusterConfiguration ----------------------------------------------------
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
kubernetesVersion: "{{ kubeadm_init_kubernetes_version }}"
# HA: every node and every 'kubeadm join --control-plane' points here
# instead of a single node's IP. This MUST be the kube-vip VIP, and the
# kube-vip static pod MUST already be running on this node before this
# init runs (see playbooks/08-kube-vip.yml, which runs before 09).
controlPlaneEndpoint: "{{ kubeadm_init_control_plane_endpoint }}:{{ kubeadm_init_control_plane_endpoint_port }}"
networking:
  podSubnet: "{{ kubeadm_init_pod_subnet }}"
  serviceSubnet: "{{ kubeadm_init_service_subnet }}"
  dnsDomain: "{{ kubeadm_init_cluster_dns_domain }}"

---
# --- KubeletConfiguration ----------------------------------------------------
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
cgroupDriver: "{{ kubeadm_init_cgroup_driver }}"
