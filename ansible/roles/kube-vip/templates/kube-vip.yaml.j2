# ============================================================================
# /etc/kubernetes/manifests/kube-vip.yaml
# Generated by Ansible role kube-vip.
# DO NOT EDIT MANUALLY — changes are overwritten on next playbook run.
# ----------------------------------------------------------------------------
# Static pod: kubelet starts this directly, no API server involved. Runs
# in ARP mode — one kube-vip instance per control plane node, leader
# election decides which one currently answers ARP for the VIP.
# ============================================================================
apiVersion: v1
kind: Pod
metadata:
  name: kube-vip
  namespace: kube-system
spec:
  hostNetwork: true
  containers:
    - name: kube-vip
      image: "{{ kube_vip_image }}"
      imagePullPolicy: IfNotPresent
      args:
        - manager
      env:
        - name: vip_arp
          value: "true"
        - name: port
          value: "6443"
        - name: vip_interface
          value: "{{ kube_vip_interface }}"
        - name: vip_cidr
          value: "32"
        - name: cp_enable
          value: "true"
        - name: cp_namespace
          value: "kube-system"
        - name: vip_ddns
          value: "false"
        - name: svc_enable
          value: "false"
        - name: vip_leaderelection
          value: "true"
        - name: vip_leaseduration
          value: "5"
        - name: vip_renewdeadline
          value: "3"
        - name: vip_retryperiod
          value: "1"
        - name: address
          value: "{{ kube_vip_vip_address }}"
      securityContext:
        capabilities:
          add:
            - NET_ADMIN
            - NET_RAW
      volumeMounts:
        - mountPath: /etc/kubernetes/admin.conf
          name: kubeconfig
  hostAliases:
    - ip: 127.0.0.1
      hostnames:
        - kubernetes
  volumes:
    - name: kubeconfig
      hostPath:
        path: "{{ kube_vip_kubeconfig_source }}"
        type: FileOrCreate
status: {}
