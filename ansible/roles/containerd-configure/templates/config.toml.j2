# ============================================================================
# /etc/containerd/config.toml — generated by Ansible role containerd-configure
# DO NOT EDIT MANUALLY — your changes will be overwritten.
# ============================================================================

version = 2

# Where containerd stores its state (containers, images, snapshots).
root = "{{ containerd_config_root_dir }}"
state = "{{ containerd_config_state_dir }}"

# OOM score adjustment: makes containerd less likely to be killed by the
# OOM killer (a negative value lowers priority for killing).
oom_score = -999

[grpc]
  address = "/run/containerd/containerd.sock"
  uid = 0
  gid = 0

[plugins."io.containerd.grpc.v1.cri"]
  # The 'pause' container image (sandbox container that holds pod's network
  # namespace open). K8s expects a specific image here.
  sandbox_image = "{{ containerd_sandbox_image }}"

  # If true, containerd marks the pod's network namespace as belonging to
  # the host. Set to false because K8s creates its own network namespace
  # per pod.
  disable_apparmor = false

[plugins."io.containerd.grpc.v1.cri".containerd]
  default_runtime_name = "runc"
  # If true, snapshotter operations are recursive (mount layers in order).
  # Default is true; explicit here for clarity.
  snapshotter = "overlayfs"

[plugins."io.containerd.grpc.v1.cri".containerd.runtimes.runc]
  runtime_type = "io.containerd.runc.v2"

[plugins."io.containerd.grpc.v1.cri".containerd.runtimes.runc.options]
  # CRITICAL: tells containerd to use systemd as the cgroup manager.
  # This MUST match kubelet's cgroupDriver setting (also systemd).
  # If mismatched, pods will crash with "OCI runtime create failed" errors.
  SystemdCgroup = {{ containerd_use_systemd_cgroup | string | lower }}
