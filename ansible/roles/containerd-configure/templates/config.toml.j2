# ============================================================================
# /etc/containerd/config.toml — generated by Ansible role containerd-configure
# DO NOT EDIT MANUALLY — your changes will be overwritten.
# ----------------------------------------------------------------------------
# This template targets containerd 2.x with config schema version 3.
# The plugin path layout changed between v2 and v3:
#   v2 path: [plugins."io.containerd.grpc.v1.cri"]
#   v3 path: [plugins.'io.containerd.cri.v1.runtime']  (runtime)
#            [plugins.'io.containerd.cri.v1.images']   (images, registry, etc.)
# Using v2 paths against containerd 2.x results in the paths being ignored
# without warning — the CRI plugin loads with compiled-in defaults and the
# runtime.v1.RuntimeService gRPC endpoint never starts. Symptom: 'crictl
# version' returns 'unknown service runtime.v1.RuntimeService'.
# Reference: https://github.com/containerd/containerd/blob/main/docs/cri/config.md
# ============================================================================
version = 3

# Where containerd stores its state (containers, images, snapshots).
root = "{{ containerd_config_root_dir }}"
state = "{{ containerd_config_state_dir }}"

# OOM score adjustment: makes containerd less likely to be killed by the
# OOM killer (a negative value lowers priority for killing).
oom_score = -999

[grpc]
  address = "/run/containerd/containerd.sock"
  uid = 0
  gid = 0

# ----------------------------------------------------------------------------
# CRI Images plugin (v3 schema).
# Controls image pulling, sandbox image (pause container), registry config.
# ----------------------------------------------------------------------------
[plugins.'io.containerd.cri.v1.images']
  snapshotter = "overlayfs"

[plugins.'io.containerd.cri.v1.images'.pinned_images]
  # The 'pause' container image. K8s expects this exact image. kubeadm
  # verifies this matches its expected sandbox image and warns if not.
  sandbox = "{{ containerd_sandbox_image }}"

# ----------------------------------------------------------------------------
# CRI Runtime plugin (v3 schema).
# Controls how containers actually run (runc, cgroup driver, etc.).
# ----------------------------------------------------------------------------
[plugins.'io.containerd.cri.v1.runtime']
  disable_apparmor = false

[plugins.'io.containerd.cri.v1.runtime'.containerd]
  default_runtime_name = "runc"

[plugins.'io.containerd.cri.v1.runtime'.containerd.runtimes.runc]
  runtime_type = "io.containerd.runc.v2"

[plugins.'io.containerd.cri.v1.runtime'.containerd.runtimes.runc.options]
  # CRITICAL: tells containerd to use systemd as the cgroup manager.
  # This MUST match kubelet's cgroupDriver setting (also systemd).
  # If mismatched, pods crash with "OCI runtime create failed" errors.
  # See ADR-013 for the full reasoning behind the systemd choice.
  SystemdCgroup = {{ containerd_use_systemd_cgroup | string | lower }}
