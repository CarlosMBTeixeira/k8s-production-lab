cfg() { jq -r "$1" <<<"$CONF"; }
VER=$(cfg '.cniVersion // "1.0.0"')
err() { # code msg
    jq -cn --arg v "$VER" --argjson c "$1" --arg m "$2" '{cniVersion:$v, code:$c, msg:$m}' >&3
    exit 1
}

if [ "${CNI_COMMAND:-}" = VERSION ]; then
    echo '{"cniVersion":"1.0.0","supportedVersions":["1.0.0"]}' >&3; exit 0
fi

