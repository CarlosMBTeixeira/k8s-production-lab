# Caddy serves HTTP/1.1, HTTP/2 and HTTP/3 (QUIC, UDP 443) on one site,
# with a certificate from its own internal CA.
https://quic.lab.local {
    tls internal
    # Backtick string with a real newline: Caddyfile double quotes don't
    # interpret \n, so "…\n" would print a literal backslash-n.
    respond `hello over {http.request.proto}
`
}
